# Django settings
DJANGO_SETTINGS_MODULE=djangoerp.settings.dev
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite at ./db.sqlite3 if unset)
DATABASE_URL=sqlite:///db.sqlite3

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# Left unset on purpose: dev settings default to True (tasks run in-process, so
# reports and MRP runs need no worker) and prod defaults to False. Set it only
# when you are deliberately running `celery -A djangoerp worker` against dev.
# CELERY_TASK_ALWAYS_EAGER=False

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin account -----------------------------------------------------------
# Seeded on first `docker compose up` by docker/bootstrap-admin.py, which also
# creates the accounts.UserRole row — without it the account can open /admin/
# but every API endpoint denies it (accounts/permissions.py reads user.role.role).
# The password is never reset on an existing account; use `manage.py
# changepassword` to rotate it.
DJANGO_SUPERUSER_USERNAME=djangoerp
DJANGO_SUPERUSER_PASSWORD=djangoerp
DJANGO_SUPERUSER_EMAIL=admin@djangoerp.local
# One of: admin, accountant, viewer, auditor
DJANGO_SUPERUSER_ROLE=admin

# --- Docker Compose only (see docker-compose.yml / README.md) -----------------
# These are read by compose, not by Django. The container environment overrides
# anything set above, so DATABASE_URL/REDIS_URL here stay the venv values.

# 1 runs Django (and the worker) under debugpy; VS Code's preLaunchTask sets it.
DEBUGPY_ENABLE=0
# 1 blocks startup until a debugger attaches — for breakpointing AppConfig.ready,
# settings or migrations.
DEBUGPY_WAIT=0

# Published ports bind to loopback: an open debugpy port is remote code
# execution, and this stack ships a known admin password. Set BIND_HOST=0.0.0.0
# only if you deliberately want the stack reachable from your network.
BIND_HOST=127.0.0.1

# Host-side published ports. Postgres and Redis default off 5432/6379 so they
# never collide with a local instance; containers talk to db:5432 / redis:6379.
DJANGO_PORT=8000
DEBUGPY_WEB_PORT=5678
DEBUGPY_WORKER_PORT=5679
POSTGRES_PORT=5433
REDIS_PORT=6380
